<div id="<%= dom_id todo %>">
  <p>
    <strong>Description:</strong>
    <%= todo.description %>
  </p>

  <p>
    <%= button_to (todo.high_priority? ? "★ High priority" : "☆ Normal"),
                  toggle_priority_todo_path(todo),
                  method: :patch,
                  data: { turbo_method: :patch },
                  form: { data: { turbo_stream: true } } %>
  </p>
</div>
